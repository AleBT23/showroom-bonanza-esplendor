# ──────────────────────────────────────────
# SHOWROOM BONANZA — .gitignore
# CASA BONANZA (CBZ)
# ──────────────────────────────────────────

# Dependencias de Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de entorno
.env
.env.local
.env.*.local

# Archivos de sistema — Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Archivos de sistema — macOS
.DS_Store
.AppleDouble
.LSOverride

# Archivos de editores
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Logs
*.log

# Archivos temporales
*.tmp
*.temp

# Build / distribución (si se agrega en el futuro)
dist/
build/

# ──────────────────────────────────────────
# NOTA: Los recursos en 01_RECURSOS/ SÍ se
# rastrean con Git para mantener respaldo
# completo del proyecto.
# ──────────────────────────────────────────
